<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carla_sensor_publisher</name>
  <version>1.0.0</version>
  <description>
    CARLA 0.10 sensor publisher — C++ ROS 2 node.
    Ouster OS0-64 LiDAR, Velodyne LiDAR, ZED 2 stereo camera,
    dual IMU, dual GNSS, and vehicle control via GaeControlCmd.
  </description>
  <maintainer email="tunay@itu.edu.tr">Tunay Kerem</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>gae_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
